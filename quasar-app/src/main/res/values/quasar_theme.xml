<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match the app-local roles before the activity's first frame, including
         the system-owned starting window. Runtime insets have a single owner. -->
    <style name="Theme.Quasar" parent="Theme.Quasar.Light" />
    <style name="Theme.Quasar.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F3F5F7</item>
        <item name="android:statusBarColor">#F3F5F7</item>
        <item name="android:navigationBarColor">#F3F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Quasar.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#06080C</item>
        <item name="android:statusBarColor">#06080C</item>
        <item name="android:navigationBarColor">#06080C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
