            </Complication>
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="450" height="450" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="225" centerY="225" width="410" height="410" startAngle="200" endAngle="200" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN] ? 200 : 200 + clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 140" />
