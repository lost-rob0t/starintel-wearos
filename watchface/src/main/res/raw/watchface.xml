                    <Arc centerX="48" centerY="48" width="82" height="82" startAngle="0" endAngle="0" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN] ? 0 : clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 360" />
                        <Stroke color="[CONFIGURATION.themeColor.1]" thickness="6" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="10" y="20" width="76" height="56">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.2]"><Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="6" displayName="@string/slot_text_region" supportedTypes="SHORT_TEXT LONG_TEXT EMPTY" x="120" y="382" width="210" height="42">
            <BoundingRoundBox x="0" y="0" width="210" height="42" cornerRadius="14" outlinePadding="4" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="210" height="42">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.themeColor.2]"><Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
