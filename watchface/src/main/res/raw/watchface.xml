<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration
            id="themeColor"
            displayName="@string/theme_picker"
            screenReaderText="@string/theme_picker"
            defaultValue="1">
            <ColorOption id="0" displayName="@string/theme_starintel_cyan" colors="#00E5FF #6E7BFF #F7FBFF #273142 #000000" />
            <ColorOption id="1" displayName="@string/theme_neon_magenta_cyan" colors="#00E5FF #FF2BD6 #F7FBFF #4A365C #000000" />
            <ColorOption id="2" displayName="@string/theme_starintel_gold" colors="#FFC857 #FF9F1C #FFF4D6 #5B4930 #000000" />
            <ColorOption id="3" displayName="@string/theme_tactical_green" colors="#62FF8A #20C96B #E9FFED #31543B #000000" />
            <ColorOption id="4" displayName="@string/theme_monochrome" colors="#FFFFFF #BFC7D5 #FFFFFF #505865 #000000" />
            <ColorOption id="5" displayName="@string/theme_neutral" colors="#9CC2E5 #A8B4C4 #F5F7FA #4E5968 #000000" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#000000">
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.themeColor.4]" />
            </Rectangle>
        </PartDraw>

        <Group x="0" y="0" width="450" height="450" name="accents" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Ellipse x="12" y="12" width="426" height="426">
                    <Stroke color="[CONFIGURATION.themeColor.0]" thickness="3" />
                </Ellipse>
                <Ellipse x="22" y="22" width="406" height="406">
                    <Stroke color="[CONFIGURATION.themeColor.1]" thickness="1" />
                </Ellipse>
                <Line startX="105" startY="225" endX="345" endY="225">
                    <Stroke color="[CONFIGURATION.themeColor.3]" thickness="1" />
                </Line>
            </PartDraw>
            <PartText x="0" y="75" width="450" height="28">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.1]">STARINTEL</Font>
                </Text>
            </PartText>
        </Group>

        <DigitalClock x="65" y="112" width="320" height="94">
            <TimeText x="0" y="0" width="320" height="94" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="72" color="[CONFIGURATION.themeColor.2]" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot
            slotId="4"
            displayName="@string/slot_left_edge"
            supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="0" y="0" width="450" height="450">
            <BoundingArc centerX="225" centerY="225" width="410" height="410" thickness="34" isRoundEdge="TRUE" startAngle="200" endAngle="340" direction="CLOCKWISE" outlinePadding="6" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="12" y="190" width="84" height="70">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.0]">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc centerX="225" centerY="225" width="410" height="410" startAngle="200" endAngle="200" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN] ? 200 : 200 + clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 140" />
                        <Stroke color="[CONFIGURATION.themeColor.0]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="12" y="190" width="84" height="70">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.2]">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            slotId="5"
            displayName="@string/slot_right_edge"
            supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="0" y="0" width="450" height="450">
            <BoundingArc centerX="225" centerY="225" width="410" height="410" thickness="34" isRoundEdge="TRUE" startAngle="20" endAngle="160" direction="CLOCKWISE" outlinePadding="6" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="354" y="190" width="84" height="70">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.1]">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc centerX="225" centerY="225" width="410" height="410" startAngle="20" endAngle="20" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN] ? 20 : 20 + clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 140" />
                        <Stroke color="[CONFIGURATION.themeColor.1]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="354" y="190" width="84" height="70">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.2]">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="1" displayName="@string/slot_lower_left" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" x="52" y="270" width="96" height="96">
            <BoundingOval x="0" y="0" width="96" height="96" outlinePadding="4" />
            <DefaultProviderPolicy primaryProvider="actor.starintel.wear/actor.starintel.wear.complications.StatusComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="96">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.themeColor.0]"><Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Arc centerX="48" centerY="48" width="82" height="82" startAngle="0" endAngle="0" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN] ? 0 : clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 360" />
                        <Stroke color="[CONFIGURATION.themeColor.0]" thickness="6" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="10" y="20" width="76" height="56">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.themeColor.2]"><Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" displayName="@string/slot_lower_center" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" x="177" y="282" width="96" height="96">
            <BoundingOval x="0" y="0" width="96" height="96" outlinePadding="4" />
            <DefaultProviderPolicy primaryProvider="actor.starintel.wear/actor.starintel.wear.complications.TargetsComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="96">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
