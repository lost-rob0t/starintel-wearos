                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="@string/slot_lower_right" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" x="302" y="270" width="96" height="96">
            <BoundingOval x="0" y="0" width="96" height="96" outlinePadding="4" />
            <DefaultProviderPolicy primaryProvider="actor.starintel.wear/actor.starintel.wear.complications.DocumentsComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="96">
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
