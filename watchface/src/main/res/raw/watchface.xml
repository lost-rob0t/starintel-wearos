            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="450" height="450" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="225" centerY="225" width="410" height="410" startAngle="204" endAngle="220"><Stroke color="[CONFIGURATION.themeColor.1]" thickness="9" cap="ROUND" /></Arc>
